// 错误测试案例8: 作用域错误

int main() {
    int a = 10;
    
    {
        int b = 20;
        int c = a + b;  // 正确：a和b都可见
    }
    
    int d = b;          // 错误：b超出作用域，不可见
    
    {
        int e = 30;
        {
            int f = e;  // 正确：e可见
        }
        int g = f;      // 错误：f超出作用域，不可见
    }
    
    return a + d;
}
