int a[200][200];
int b[200][200];
int c[200][200];
int main(){
    int n;
    int i;
    int j;
    int k;

    i = 0;
    while(i<200){
        j = 0;
        while(j<200){
            k = 0;
            int temp = 0;
            while(k<200){
                if(a[i][k]*b[k][j] % 2 == 0)
                    temp = temp + a[i][k]*b[k][j];
                k = k+1;
            }
            c[i][j] = temp;
            j = j+1;
        }
        i = i+1;
    }

    return 0;
}

