CompUnitNode
  Function
    int testFunction(
      Parameters:
        DeclStmtNode: input : int
        DeclStmtNode: length : int
    )
    BlockStmtNode
      DeclStmtNode: i : int = InitExprNode: IntegerLiteralExprNode: 0

      DeclStmtNode: sum : int = InitExprNode: IntegerLiteralExprNode: 0

      WhileStmtNode
        BinaryExprNode: LValueExprNode: i < LValueExprNode: length
          LValueExprNode: i
          LValueExprNode: length
        BlockStmtNode
          AssignStmtNode
            LValueExprNode: sum
            BinaryExprNode: LValueExprNode: input + LValueExprNode: sum
              LValueExprNode: input
                LValueExprNode: i
              LValueExprNode: sum
          AssignStmtNode
            LValueExprNode: i
            BinaryExprNode: LValueExprNode: i + IntegerLiteralExprNode: 1
              LValueExprNode: i
              IntegerLiteralExprNode: 1
      ReturnStmtNode
        LValueExprNode: sum
