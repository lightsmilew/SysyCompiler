define i32 @testArrayElementConversion() {
entry:
  %intArray = alloca [3 x i32]
  %t284 = getelementptr [3 x i32], [3 x i32]* %intArray, i32 0, i32 0
  store i32 1, i32* %t284
  %t285 = getelementptr [3 x i32], [3 x i32]* %intArray, i32 0, i32 1
  store i32 2, i32* %t285
  %t286 = getelementptr [3 x i32], [3 x i32]* %intArray, i32 0, i32 2
  store i32 3, i32* %t286
  %floatVar = alloca float
  %t287 = getelementptr [3 x i32], [3 x i32]* %intArray, i32 0, i32 0
  %t288 = load i32, i32* %t287
  %t289 = sitofp i32 %t288 to float
  store float %t289, float* %floatVar
  %t290 = getelementptr [3 x i32], [3 x i32]* %intArray, i32 0, i32 1
  %t291 = load i32, i32* %t290
  %t292 = sitofp i32 %t291 to float
  %t293 = fadd float %t292, 0x0000000040200000
  store float %t293, float* %floatVar
  %t294 = load float, float* %floatVar
  %t295 = fptosi float %t294 to i32
  ret i32 %t295
}

