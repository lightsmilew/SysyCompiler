  %t228 = load i32, i32* %result1
  %t229 = load i32, i32* %result2
  %t230 = add i32 %t228, %t229
  ret i32 %t230
}

define void @testControl() {
entry:
  %arr1 = alloca [5 x i32]
  %t231 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 0
  store i32 1, i32* %t231
  %t232 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 1
  store i32 2, i32* %t232
  %t233 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 2
  store i32 3, i32* %t233
  %t234 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 3
  store i32 4, i32* %t234
  %t235 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 4
  store i32 5, i32* %t235
  %matrix = alloca [2 x [3 x i32]]
  %t236 = getelementptr [2 x [3 x i32]], [2 x [3 x i32]]* %matrix, i32 0, i32 0, i32 0
  store i32 1, i32* %t236
  %t237 = getelementptr [2 x [3 x i32]], [2 x [3 x i32]]* %matrix, i32 0, i32 0, i32 1
  store i32 2, i32* %t237
  %t238 = getelementptr [2 x [3 x i32]], [2 x [3 x i32]]* %matrix, i32 0, i32 0, i32 2
  store i32 3, i32* %t238
  %t239 = getelementptr [2 x [3 x i32]], [2 x [3 x i32]]* %matrix, i32 0, i32 1, i32 0
  store i32 4, i32* %t239
  %t240 = getelementptr [2 x [3 x i32]], [2 x [3 x i32]]* %matrix, i32 0, i32 1, i32 1
  store i32 5, i32* %t240
  %t241 = getelementptr [2 x [3 x i32]], [2 x [3 x i32]]* %matrix, i32 0, i32 1, i32 2
  store i32 6, i32* %t241
  %x = alloca i32
  store i32 0, i32* %x
  %y = alloca i32
  store i32 0, i32* %y
  %t242 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 1
  %t243 = load i32, i32* %t242
  %t244 = getelementptr [2 x [3 x i32]], [2 x [3 x i32]]* %matrix, i32 0, i32 0, i32 1
  %t245 = load i32, i32* %t244
  %t246 = icmp sgt i32 %t243, %t245
  br i1 %t246, label %if.then, label %if.else
if.then:
  %e = alloca i32
  store i32 0, i32* %e
  %t247 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 1
  %t248 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 1
  %t249 = load i32, i32* %t248
  %t250 = add i32 %t249, 1
  store i32 %t250, i32* %t247
  %t251 = load i32, i32* %x
  %t252 = add i32 %t251, 1
  store i32 %t252, i32* %x
  br label %if.end
if.else:
  %t253 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 1
  %t254 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 1
  %t255 = load i32, i32* %t254
  %t256 = sub i32 %t255, 1
  store i32 %t256, i32* %t253
  %t257 = load i32, i32* %x
  %t258 = sub i32 %t257, 1
  store i32 %t258, i32* %x
  br label %if.end
if.end:
  %t259 = load i32, i32* %x
  store i32 %t259, i32* %y
  %j = alloca i32
  store i32 0, i32* %j
  br label %while.cond
while.cond:
  %t260 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 4
  %t261 = load i32, i32* %t260
  %t262 = icmp sgt i32 %t261, 0
  br i1 %t262, label %while.body, label %while.end
while.body:
  %t263 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 4
  %t264 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 4
  %t265 = load i32, i32* %t264
  %t266 = sub i32 %t265, 1
  store i32 %t266, i32* %t263
  %t267 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 3
  %t268 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 3
  %t269 = load i32, i32* %t268
  %t270 = add i32 %t269, 1
  store i32 %t270, i32* %t267
  %t271 = load i32, i32* %j
  %t272 = add i32 %t271, 1
  store i32 %t272, i32* %j
  %t273 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 3
  %t274 = load i32, i32* %t273
  %t275 = icmp sgt i32 %t274, 8
  br i1 %t275, label %if.then, label %if.else
while.end:
  ret void
if.then:
  br label %while.end
if.else:
  br label %while.cond
if.end:
  br label %while.cond
}

define i32 @testArrayDimensions() {
