// 错误测试案例6: 数组访问错误
int main() {
    int arr[5];
    int matrix[3][4];
    
    // 维度错误
    int a = arr[0][1];     // 错误：一维数组不能用二维索引
    int b = matrix[0];     // 错误：二维数组不能用一维索引
    
    // 索引类型错误
    float idx = 1.5;
    int c = arr[idx];      // 错误：数组索引必须是整数类型
    
    return a + b + c + d + e;
}
    