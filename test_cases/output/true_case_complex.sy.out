  %t211 = load i32, i32* %t210
  %t212 = add i32 %t209, %t211
  ret i32 %t212
}

define i32 @testArrayAsParameter() {
entry:
  %arr1 = alloca [5 x i32]
  %t213 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 0
  store i32 1, i32* %t213
  %t214 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 1
  store i32 2, i32* %t214
  %t215 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 2
  store i32 3, i32* %t215
  %t216 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 3
  store i32 4, i32* %t216
  %t217 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 4
  store i32 5, i32* %t217
  %matrix = alloca [2 x [3 x i32]]
  %t218 = getelementptr [2 x [3 x i32]], [2 x [3 x i32]]* %matrix, i32 0, i32 0, i32 0
  store i32 1, i32* %t218
  %t219 = getelementptr [2 x [3 x i32]], [2 x [3 x i32]]* %matrix, i32 0, i32 0, i32 1
  store i32 2, i32* %t219
  %t220 = getelementptr [2 x [3 x i32]], [2 x [3 x i32]]* %matrix, i32 0, i32 0, i32 2
  store i32 3, i32* %t220
  %t221 = getelementptr [2 x [3 x i32]], [2 x [3 x i32]]* %matrix, i32 0, i32 1, i32 0
  store i32 4, i32* %t221
  %t222 = getelementptr [2 x [3 x i32]], [2 x [3 x i32]]* %matrix, i32 0, i32 1, i32 1
  store i32 5, i32* %t222
  %t223 = getelementptr [2 x [3 x i32]], [2 x [3 x i32]]* %matrix, i32 0, i32 1, i32 2
  store i32 6, i32* %t223
  %result1 = alloca i32
  %t224 = getelementptr [5 x i32], [5 x i32]* %arr1, i32 0, i32 0
  %t225 = call i32 @processArray(i32* %t224)
