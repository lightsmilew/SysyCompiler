{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug SysY Compiler",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/my_compiler", // 替换为你的可执行文件路径
            "args": ["src/test.c"], // 这里填写你的输入文件名
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用漂亮打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}