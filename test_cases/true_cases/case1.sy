//测试已覆盖的翻译语法成分：函数声明、函数调用、变量声明及初始化、数组声明及初始化、变量赋值
int func_add(int a, int b) {
    return a + b;
}
int func_sub(int a, int b) {
    return a - b;
}
void func_void() {
    return;
    // do nothing
}
int global_a=10;
int main() {
    int x = 5;
    int y = 10;
    int z;
    int b[3]={1, 2, 3};
    b[1]=4;
    int tmp_b = b[1]; // c应该是4
    int c[3]={4, {5}, 6};
    int d[3][2] = {{1, 2}, {3, 4}, {5, 6}};
    //初始化5个值
    int e[3][2]={1,2,3,4,5};
    int f[2][2][2]={{{1,2},{3,4}},{{1,2},{3,4}}};
    int g[3];
    g[0]=1;
    int result=func_add(x,y)*func_sub(global_a, 5); // result应该是75

    
    return 0; 
}
