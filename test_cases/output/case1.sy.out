define i32 @func(i32 %a, i32 %b) {
entry:
  %a = alloca i32
  store i32 %a, i32* %a
  %b = alloca i32
  store i32 %b, i32* %b
  %t0 = load i32, i32* %a
  %t1 = load i32, i32* %b
  %t2 = add i32 %t0, %t1
  ret i32 %t2
}

